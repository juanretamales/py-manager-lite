# ==============================================================================
# py-manager-lite - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a `.env` y completa tus credenciales locales o remotas.
# NUNCA compartas ni subas tu archivo `.env` real al repositorio público.
# ==============================================================================

# ------------------------------------------------------------------------------
# Conectividad Cloud Opcional (Turso / LibSQL)
# ------------------------------------------------------------------------------
# DATABASE_TURSO_URL="libsql://tu-base-de-datos.turso.io"
# DATABASE_TURSO_TOKEN="eyJhbGciOiJFZERT..."
database_turso_url=
database_turso_token=

# ------------------------------------------------------------------------------
# Proveedores de Inteligencia Artificial (Opcionales)
# ------------------------------------------------------------------------------
# OpenRouter API Key (para modelos open source o multimodales)
openrouter_apikey=

# Google Gemini API Key
gemini_api_key=

# ------------------------------------------------------------------------------
# Base de Datos Local (Opcional, por defecto usa sqlite:///data/app.db)
# ------------------------------------------------------------------------------
# DATABASE_URL="sqlite:///data/app.db"
